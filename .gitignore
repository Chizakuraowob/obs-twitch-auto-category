# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/docs
!/scripts
!/tests
!/resources
!/installer
!github_README.md
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Publish only the user, contributor, build, and license documentation below.
# New notes and author-only documents under docs/ stay local by default.
/docs/*
!/docs/ci-release.md
!/docs/contributors.md
!/docs/data-processing.md
!/docs/development.md
!/docs/privacy.md
!/docs/source-distribution.md
!/docs/terms.md
!/docs/third-party.md
!/docs/toolchain-setup.md
!/docs/images/
!/docs/licenses/

# Local configuration, credentials, editor state, and diagnostics at any depth.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
*.local.*
*.user
*.suo
*.log
*.dmp
__pycache__/
*.pyc
.vs/
.idea/
.codex/
node_modules/
CMakeUserPresets.json
settings.json
settings.json.backup-*
settings.json.before-restore-*

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
