<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="$(var.ProductName)" Manufacturer="Twitch Category Assistant contributors"
           Version="$(var.ProductVersion)" Language="1028" Codepage="950" Scope="perMachine"
           UpgradeCode="BF633767-A341-4DDC-9007-BEF9D7DA2F4B">
    <MajorUpgrade DowngradeErrorMessage="已安裝較新的 Twitch 分類助手，請使用相同或更新版本。" />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="Installed OR (VersionNT64 AND WindowsBuild &gt;= 22000)" Message="需要 Windows 11 x64。" />
    <Property Id="OBSEXE" Secure="yes">
      <RegistrySearch Id="ObsRegistry" Root="HKLM" Key="SOFTWARE\OBS Studio" Type="directory" Bitness="always64">
        <DirectorySearch Id="ObsBinFolder" Path="bin" Depth="0">
          <DirectorySearch Id="ObsExecutableFolder" Path="64bit" Depth="0">
            <!-- MSI compares language at an equal MinVersion; use the immediately preceding version. -->
            <FileSearch Id="ObsExecutableFolder" Name="obs64.exe" MinVersion="32.2.1.65535" MaxVersion="32.2.2.65535" />
          </DirectorySearch>
        </DirectorySearch>
      </RegistrySearch>
    </Property>
    <Launch Condition="Installed OR OBSEXE" Message="請先安裝 OBS Studio 32.2.2 x64。可攜版請使用手動安裝方式。" />
    <!-- Never force-kill OBS, restart Windows, or let Restart Manager close a live stream silently. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <util:CloseApplication Id="CloseObsInteractive" Target="obs64.exe" Condition="UILevel &gt;= 4"
        Description="OBS 正在執行。請先結束直播或錄影並儲存設定。按「重試」重新檢查；按「略過」請求 OBS 正常關閉；按「中止」取消安裝。外掛安裝器不會強制終止 OBS。"
        PromptToContinue="yes" CloseMessage="yes" EndSessionMessage="no" RebootPrompt="no" Timeout="15" Property="OBSRUNNING" Sequence="1" />
    <util:CloseApplication Id="CheckObsSilent" Target="obs64.exe" Condition="UILevel &lt; 4"
        CloseMessage="no" RebootPrompt="no" Property="OBSRUNNING" Sequence="2" />
    <CustomAction Id="ObsStillRunning" Error="OBS 尚未關閉。安裝已取消，請關閉 OBS 後重試。" />
    <InstallExecuteSequence>
      <Custom Action="ObsStillRunning" After="Wix4CloseApplications_X64" Condition="OBSRUNNING" />
    </InstallExecuteSequence>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ObsData" Name="obs-studio">
        <Directory Id="ObsPlugins" Name="plugins">
          <Directory Id="INSTALLFOLDER" Name="twitch-category-assistant">
            <Component Id="LicenseFile" Guid="*"><File Source="$(var.ProjectRoot)\LICENSE" KeyPath="yes" /></Component>
            <Component Id="ReadmeFile" Guid="*"><File Source="$(var.ProjectRoot)\github_README.md" KeyPath="yes" /></Component>
            <Directory Id="PluginBin" Name="bin"><Directory Id="PluginBin64" Name="64bit">
              <Component Id="PluginDll" Guid="*"><File Source="$(var.Payload)\bin\64bit\twitch-category-assistant.dll" KeyPath="yes" /></Component>
            </Directory></Directory>
            <Directory Id="PluginData" Name="data"><Directory Id="PluginLocale" Name="locale">
              <Component Id="ChineseLocale" Guid="*"><File Source="$(var.Payload)\data\locale\zh-TW.ini" KeyPath="yes" /></Component>
              <Component Id="EnglishLocale" Guid="*"><File Source="$(var.Payload)\data\locale\en-US.ini" KeyPath="yes" /></Component>
            </Directory></Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="PluginFeature" Title="OBS Twitch 分類助手" Level="1">
      <ComponentRef Id="PluginDll" /><ComponentRef Id="ChineseLocale" /><ComponentRef Id="EnglishLocale" />
      <ComponentRef Id="LicenseFile" /><ComponentRef Id="ReadmeFile" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="完成後啟動 OBS Studio" />
    <SetProperty Id="WixShellExecTarget" Value="[OBSEXE]" After="AppSearch" Sequence="ui" />
    <CustomAction Id="LaunchObs" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchObs" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND OBSEXE" />
    </UI>
  </Package>
</Wix>
