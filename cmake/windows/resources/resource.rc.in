#pragma code_page(65001)
1 VERSIONINFO
 FILEVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${TCA_REVISION}
 PRODUCTVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${TCA_REVISION}
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x0L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "${TCA_META_author}"
            VALUE "FileDescription", "${TCA_META_description}"
            VALUE "FileVersion", "${PROJECT_VERSION}.${TCA_REVISION}"
            VALUE "InternalName", "${PROJECT_NAME}"
            VALUE "LegalCopyright", "${TCA_META_copyright}"
            VALUE "OriginalFilename", "${PROJECT_NAME}.dll"
            VALUE "ProductName", "${TCA_META_displayName}"
            VALUE "ProductVersion", "${PROJECT_VERSION}"
            VALUE "Comments", "${TCA_META_email}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
